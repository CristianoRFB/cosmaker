rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{userId} { allow read, update: if signedIn() && request.auth.uid == userId; allow create: if signedIn(); }
    match /ateliers/{atelierId} { allow read: if signedIn(); allow write: if false; /* TODO: implementar membership/roles */ }
    match /{document=**} { allow read, write: if false; }
  }
}
