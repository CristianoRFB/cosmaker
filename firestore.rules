// Authority: users/{uid} is server-managed except presentation; tenant members require
// verified Auth, an active atelier_member profile in that tenant, active tenant and membership.
// Client quotes/intake/references are callable projections; raw documents may contain private fields.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath)
        && get(profilePath).data.active == true
        && (request.auth.token.platformAdmin == true || get(profilePath).data.accountType == 'platform_admin');
    }

    function memberPath(atelierId, userId) {
      return /databases/$(database)/documents/ateliers/$(atelierId)/members/$(userId);
    }

    function isAtelierMember(atelierId) {
      let atelierPath = /databases/$(database)/documents/ateliers/$(atelierId);
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath) && get(profilePath).data.active == true
        && get(profilePath).data.accountType == 'atelier_member'
        && get(profilePath).data.atelierId == atelierId
        && exists(atelierPath)
        && get(atelierPath).data.active == true
        && exists(memberPath(atelierId, request.auth.uid))
        && get(memberPath(atelierId, request.auth.uid)).data.active == true;
    }

    function hasAtelierPermission(atelierId, permission) {
      return isAtelierMember(atelierId)
        && (get(memberPath(atelierId, request.auth.uid)).data.role in ['owner', 'admin']
          || get(memberPath(atelierId, request.auth.uid)).data.permissions.hasAny([permission])
          || (permission == 'quotes:read'
            && get(memberPath(atelierId, request.auth.uid)).data.permissions.hasAny(['quotes:write']))
          || (permission == 'orders:read'
            && get(memberPath(atelierId, request.auth.uid)).data.permissions.hasAny(['orders:manage'])));
    }

    function isOwnClient(atelierId, clientId) {
      let clientPath = /databases/$(database)/documents/ateliers/$(atelierId)/clients/$(clientId);
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && request.auth.token.email_verified == true
        && exists(profilePath) && get(profilePath).data.active == true
        && get(profilePath).data.accountType == 'client'
        && get(/databases/$(database)/documents/ateliers/$(atelierId)).data.active == true
        && exists(clientPath) && get(clientPath).data.userId == request.auth.uid;
    }

    function canReadOrder(atelierId, orderId) {
      return activeOrderStaff(atelierId) || isOrderClient(atelierId, orderId);
    }

    function activeOrderStaff(atelierId) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && request.auth.token.email_verified == true && exists(profile) && get(profile).data.active == true
        && get(profile).data.accountType == 'atelier_member' && get(profile).data.atelierId == atelierId
        && hasAtelierPermission(atelierId, 'orders:read');
    }

    function activeFinanceStaff(atelierId) {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && request.auth.token.email_verified == true && exists(profile)
        && get(profile).data.active == true && get(profile).data.accountType == 'atelier_member'
        && get(profile).data.atelierId == atelierId
        && (hasAtelierPermission(atelierId, 'finance:read') || hasAtelierPermission(atelierId, 'finance:write'));
    }

    function orderClientLink(atelierId, orderData) {
      let clientId = orderData.get('clientId', null);
      let validClient = clientId is string && clientId.matches('[A-Za-z0-9_-]{1,150}');
      let clientKey = validClient ? clientId : '__unlinked__';
      let clientPath = /databases/$(database)/documents/ateliers/$(atelierId)/clients/$(clientKey);
      let clientUid = validClient && exists(clientPath) ? get(clientPath).data.get('userId', null) : null;
      let orderUid = orderData.get('clientUserId', null);
      // Raw reads cannot query unindexed CRM by email. Existing orders need a UID;
      // legacy unbound records remain staff-visible for deliberate reconciliation.
      return (orderData.get('atelierId', atelierId) == atelierId)
        && (clientId == null || (validClient && exists(clientPath)))
        && (orderUid == null || (orderUid is string && orderUid.matches('[^/]{1,128}')))
        && (clientUid == null || (clientUid is string && clientUid.matches('[^/]{1,128}')))
        && (!(orderUid is string && clientUid is string) || orderUid == clientUid)
        && (orderUid is string ? orderUid == request.auth.uid
          : clientUid is string && clientUid == request.auth.uid);
    }

    function isOrderClient(atelierId, orderId) {
      let orderPath = /databases/$(database)/documents/ateliers/$(atelierId)/orders/$(orderId);
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && request.auth.token.email_verified == true && exists(profile)
        && get(profile).data.active == true && get(profile).data.accountType == 'client'
        && get(/databases/$(database)/documents/ateliers/$(atelierId)).data.active == true
        && exists(orderPath) && orderClientLink(atelierId, get(orderPath).data);
    }

    // Self-service changes are presentation only. Unchanged legacy presentation fields
    // may remain until corrected; new/changed values are bounded and Auth owns email.
    function validUserPresentation(data, fields) {
      return (!fields.hasAny(['name']) || (data.get('name', null) is string && data.name.size() >= 1 && data.name.size() <= 256))
        && (!fields.hasAny(['email']) || (data.get('email', null) is string && data.email.size() <= 254 && data.email == request.auth.token.email))
        && (!fields.hasAny(['phone']) || (data.get('phone', null) is string && data.phone.size() <= 32))
        && (!fields.hasAny(['photoURL']) || (data.get('photoURL', null) is string && data.photoURL.size() <= 2048 && (data.photoURL == '' || data.photoURL.matches('https://[^ ]+'))))
        && (!fields.hasAny(['updatedAt']) || data.get('updatedAt', null) == request.time);
    }

    function validMeasurementCreateTimes() {
      let data = request.resource.data;
      return (!('createdAt' in data) || data.createdAt == request.time)
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function validMeasurementUpdateTimes() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || request.resource.data.get('updatedAt', null) == request.time);
    }

    function validMeasurement() {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'label', 'value', 'unit', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['type', 'label', 'value', 'unit'])
        && data.type is string && data.type.size() >= 1 && data.type.size() <= 80
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.value is number && data.value >= 0 && data.value <= 100000
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validMeasurementProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['clientId', 'name', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['clientId', 'name', 'active'])
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 && !data.clientId.matches('.*/.*')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.active is bool
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Client history is projected by UID-aware callables, never a global email grant.
    match /{path=**}/quotes/{quoteId} {
      allow get, list: if false;
    }

    // Cross-tenant client listing uses a callable that validates UID links and projects fields.
    match /{path=**}/orders/{orderId} {
      allow get, list: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'photoURL', 'accountType', 'role', 'permissions', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'accountType', 'role', 'permissions', 'active', 'createdAt', 'updatedAt'])
        && request.resource.data.get('id', userId) == userId
        && validUserPresentation(request.resource.data, request.resource.data.keys())
        && request.resource.data.createdAt == request.time
        && request.resource.data.accountType == 'client'
        && request.resource.data.role == 'client'
        && request.resource.data.permissions == []
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'photoURL', 'updatedAt'])
        && validUserPresentation(request.resource.data, request.resource.data.diff(resource.data).affectedKeys())
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.role == resource.data.role
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.get('atelierId', null) == resource.data.get('atelierId', null);
      allow delete: if false;
    }

    match /publicAteliers/{atelierId} {
      // Public pages consume a callable allowlist so private fields in this config document never leak.
      allow get: if false;
      allow list: if false;
      allow write: if false;
      match /portfolio/{projectId} {
        // Public catalogs are allowlisted by the slug-resolving callable.
        allow read, write: if false;
      }
    }

    match /ateliers/{atelierId} {
      allow get: if isAtelierMember(atelierId);
      allow list: if false;
      allow create, delete: if false;
      allow update: if hasAtelierPermission(atelierId, 'atelier:settings')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id', 'ownerId', 'active', 'status', 'createdAt',
          'demoWorkspace', 'plan', 'planId', 'subscriptionStatus', 'trialUntil', 'entitlementOverrides', 'limitOverrides',
        ]);

      // Commercial state and usage counters are server-managed, even for atelier owners.
      match /commercial/{documentId} {
        allow read, write: if false;
      }
      match /commercialUsage/{documentId} {
        allow read, write: if false;
      }
      match /commercialOperations/{operationId} {
        allow read, write: if false;
      }

      match /members/{memberId} {
        allow get: if signedIn() && request.auth.uid == memberId || hasAtelierPermission(atelierId, 'team:read');
        allow list: if hasAtelierPermission(atelierId, 'team:read');
        // Team mutations must pass server-side grant, ownership, and audit checks.
        allow create, update, delete: if false;
      }

      match /teamInvitations/{invitationId} {
        allow read, write: if false;
      }

      match /teamInvitationEmailIndex/{emailHash} {
        allow read, write: if false;
      }

      match /clients/{clientId} {
        // Staff use tenant-scoped callables so indexes, uniqueness, and audit are kept consistent.
        // A customer can read only their own linked profile.
        allow get: if isOwnClient(atelierId, clientId);
        allow list, create, update, delete: if false;
      }

      match /quoteRequests/{requestId} {
        allow get, list: if hasAtelierPermission(atelierId, 'quotes:read');
        // Public intake is written by a trusted callable that resolves the slug server-side.
        allow create: if false;
        allow update: if hasAtelierPermission(atelierId, 'quotes:write')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'activeQuoteId', 'assignedTo', 'notes']);
        allow delete: if false;

        match /references/{referenceId} {
          allow get, list: if hasAtelierPermission(atelierId, 'quotes:read');
          // Reference metadata is created only after the backend validates the uploaded bytes.
          allow create, update, delete: if false;
        }
      }

      match /quotes/{quoteId} {
        allow get, list: if hasAtelierPermission(atelierId, 'quotes:read');
        allow create: if false;
        allow update: if false;
        allow delete: if false;
        match /items/{itemId} {
          allow read: if hasAtelierPermission(atelierId, 'quotes:read');
          allow write: if false;
        }
        match /approvedItems/{itemId} {
          allow read: if hasAtelierPermission(atelierId, 'quotes:read');
          allow write: if false;
        }
        match /responses/{responseId} {
          allow read: if hasAtelierPermission(atelierId, 'quotes:read');
          allow write: if false;
        }
      }

      match /orders/{orderId} {
        // Internal approved snapshots include costs. Clients use getClientOrder/listClientOrders.
        allow get, list: if activeOrderStaff(atelierId);
        // Order state, payment state, approvals and history are changed only by trusted functions.
        allow create, update: if false;
        allow delete: if false;
        match /lifecycleOperations/{operationId} { allow read, write: if false; }
        match /materialRequirements/{materialId} {
          allow read: if hasAtelierPermission(atelierId, 'inventory:read') || hasAtelierPermission(atelierId, 'inventory:write');
          allow write: if false;
        }
        match /files/{fileId} {
          // Clients receive the allowlisted file projection through listOrderFiles.
          allow read: if activeOrderStaff(atelierId);
          allow write: if false;
        }
        match /productionConfigurations/{versionId} {
          allow read: if activeOrderStaff(atelierId);
          allow write: if false;
        }
        match /productionOperations/{operationId} { allow read, write: if false; }
        match /changeRequests/{changeId} { allow read, write: if false; }
        match /agreementVersions/{versionId} { allow read, write: if false; }
        match /changeRequestOperations/{operationId} { allow read, write: if false; }
        match /{subcollection}/{documentId} {
          allow read: if canReadOrder(atelierId, orderId)
            && subcollection in ['items', 'productionStages', 'photos', 'approvals', 'payments', 'statusHistory', 'measurementSnapshot']
            && (subcollection != 'photos'
              || hasAtelierPermission(atelierId, 'orders:read')
              || (isOrderClient(atelierId, orderId) && resource.data.visibleToClient == true && resource.data.uploadStatus == 'ready'))
            && (subcollection != 'payments'
              || hasAtelierPermission(atelierId, 'finance:read'));
          allow create, update, delete: if false;
          match /{nestedCollection}/{nestedId} {
            allow read: if canReadOrder(atelierId, orderId)
              && subcollection in ['productionStages', 'approvals']
              && nestedCollection in ['updates', 'events']
              && (nestedCollection != 'updates' || hasAtelierPermission(atelierId, 'orders:read'));
            allow create, update, delete: if false;
          }
        }
      }

      match /measurementProfiles/{profileId} {
        allow get, list: if hasAtelierPermission(atelierId, 'measurements:read')
          || isOwnClient(atelierId, resource.data.clientId);
        allow create: if validMeasurementProfile() && validMeasurementCreateTimes()
          && exists(/databases/$(database)/documents/ateliers/$(atelierId)/clients/$(request.resource.data.clientId))
          && (hasAtelierPermission(atelierId, 'measurements:write')
            || (request.resource.data.active == true && isOwnClient(atelierId, request.resource.data.clientId)));
        allow update: if validMeasurementProfile() && validMeasurementUpdateTimes()
          && request.resource.data.clientId == resource.data.clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active', 'updatedAt'])
          && (hasAtelierPermission(atelierId, 'measurements:write') || isOwnClient(atelierId, resource.data.clientId));
        allow delete: if false;
        match /measurements/{measurementId} {
          function parentExists() {
            return exists(/databases/$(database)/documents/ateliers/$(atelierId)/measurementProfiles/$(profileId));
          }
          function ownProfile() {
            return parentExists() && isOwnClient(atelierId, get(/databases/$(database)/documents/ateliers/$(atelierId)/measurementProfiles/$(profileId)).data.clientId);
          }
          allow read: if hasAtelierPermission(atelierId, 'measurements:read') || ownProfile();
          allow create: if parentExists() && validMeasurement() && validMeasurementCreateTimes()
            && (hasAtelierPermission(atelierId, 'measurements:write') || ownProfile());
          allow update: if parentExists() && validMeasurement() && validMeasurementUpdateTimes()
            && (hasAtelierPermission(atelierId, 'measurements:write')
              || (ownProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'unit', 'notes', 'updatedAt'])));
          allow delete: if hasAtelierPermission(atelierId, 'measurements:write');
        }
      }

      match /portfolio/{projectId} {
        allow read, write: if false;
      }
      match /showcaseOperations/{operationId} { allow read, write: if false; }
      match /preferences/{documentId} { allow read, write: if false; }
      match /settingsOperations/{operationId} { allow read, write: if false; }

      match /transactions/{transactionId} {
        allow read: if activeFinanceStaff(atelierId);
        allow write: if false;
      }
      match /expenses/{expenseId} {
        allow read: if activeFinanceStaff(atelierId);
        allow write: if false;
      }
      // Financial ledger, retry keys and compensation locks are callable-only.
      match /financeEntries/{entryId} { allow read, write: if false; }
      match /financeOperations/{operationId} { allow read, write: if false; }
      match /financeReversals/{entryId} { allow read, write: if false; }
      match /financePaymentReferences/{referenceId} { allow read, write: if false; }
      match /payments/{paymentId} {
        allow read: if activeFinanceStaff(atelierId);
        allow write: if false;
      }
      match /materials/{materialId} {
        allow read: if hasAtelierPermission(atelierId, 'inventory:read') || hasAtelierPermission(atelierId, 'inventory:write');
        allow write: if false;
      }
      match /suppliers/{supplierId} {
        allow read: if hasAtelierPermission(atelierId, 'inventory:read') || hasAtelierPermission(atelierId, 'inventory:write');
        allow write: if false;
      }
      match /inventoryMovements/{movementId} {
        allow read: if hasAtelierPermission(atelierId, 'inventory:read') || hasAtelierPermission(atelierId, 'inventory:write');
        allow write: if false;
      }
      match /inventoryReservations/{reservationId} {
        allow read: if hasAtelierPermission(atelierId, 'inventory:read') || hasAtelierPermission(atelierId, 'inventory:write');
        allow write: if false;
      }
      match /inventorySkuIndex/{sku} {
        allow read, write: if false;
      }
      match /productionSlots/{slotId} {
        allow read: if hasAtelierPermission(atelierId, 'schedule:read');
        allow write: if false;
        match /allocations/{allocationId} {
          allow read: if hasAtelierPermission(atelierId, 'schedule:read');
          allow write: if false;
        }
      }
      match /scheduleBlocks/{blockId} {
        allow read: if hasAtelierPermission(atelierId, 'schedule:read');
        allow write: if false;
      }
      match /teamCapacity/{memberId} {
        allow read: if hasAtelierPermission(atelierId, 'schedule:read');
        allow write: if false;
      }
      match /scheduleDays/{dayId} {
        allow read, write: if false;
      }
      match /services/{serviceId} {
        allow read, write: if false;
      }
      match /events/{eventId} {
        allow read: if hasAtelierPermission(atelierId, 'events:read');
        allow write: if false;
      }
      match /notifications/{notificationId} {
        // Callables validate UID and current order access again before exposing content or reading it.
        allow read, write: if false;
      }
      match /conversations/{conversationId} {
        allow read, write: if false;
        match /{document=**} { allow read, write: if false; }
      }
    }

    match /platformPlans/{planId} {
      allow get, list: if resource.data.active == true;
      allow write: if isPlatformAdmin();
    }
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /system/{configId} {
      allow read, write: if isPlatformAdmin();
    }
    match /auditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
