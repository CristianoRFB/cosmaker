{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cosmaker-spark-local-proof",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "MODE": "disabled", "PROJECT_ID": "demo-cosmaker" },
  "observability": { "enabled": false }
}
