rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAtelierMember(atelierId) {
      let atelierPath = /databases/(default)/documents/ateliers/$(atelierId);
      let memberPath = /databases/(default)/documents/ateliers/$(atelierId)/members/$(request.auth.uid);
      return signedIn()
        && firestore.exists(atelierPath)
        && firestore.get(atelierPath).data.active == true
        && firestore.exists(memberPath)
        && firestore.get(memberPath).data.active == true;
    }

    function hasAtelierPermission(atelierId, permission) {
      let memberPath = /databases/(default)/documents/ateliers/$(atelierId)/members/$(request.auth.uid);
      return isAtelierMember(atelierId)
        && (firestore.get(memberPath).data.role in ['owner', 'admin']
          || firestore.get(memberPath).data.permissions.hasAny([permission])
          || (permission == 'orders:read' && firestore.get(memberPath).data.permissions.hasAny(['orders:manage'])));
    }

    function ownVerifiedOrder(atelierId, orderId) {
      let orderPath = /databases/(default)/documents/ateliers/$(atelierId)/orders/$(orderId);
      return signedIn() && request.auth.token.email_verified == true
        && firestore.exists(orderPath)
        && ((firestore.get(orderPath).data.clientUserId is string && firestore.get(orderPath).data.clientUserId == request.auth.uid)
          || (firestore.get(orderPath).data.email is string
            && request.auth.token.email.lower() == firestore.get(orderPath).data.email.lower()));
    }

    function referenceRecordPath(atelierId, requestId, referenceId) {
      return /databases/(default)/documents/ateliers/$(atelierId)/quoteRequests/$(requestId)/references/$(referenceId);
    }

    function mayWritePublicReference(atelierId, requestId, referenceId) {
      let intakePath = /databases/(default)/documents/publicAteliers/$(atelierId);
      let atelierPath = /databases/(default)/documents/ateliers/$(atelierId);
      let requestPath = /databases/(default)/documents/ateliers/$(atelierId)/quoteRequests/$(requestId);
      let referencePath = referenceRecordPath(atelierId, requestId, referenceId);
      return firestore.exists(intakePath)
        && firestore.get(intakePath).data.published == true
        && firestore.get(intakePath).data.quoteRequestsEnabled == true
        && firestore.exists(atelierPath)
        && firestore.get(atelierPath).data.active == true
        && firestore.exists(requestPath)
        && firestore.get(requestPath).data.status == 'new'
        && firestore.exists(referencePath)
        && firestore.get(referencePath).data.uploadStatus == 'pending'
        && firestore.get(referencePath).data.storagePath == 'ateliers/' + atelierId + '/quoteRequests/' + requestId + '/references/' + referenceId
        && firestore.get(referencePath).data.size == request.resource.size
        && firestore.get(referencePath).data.contentType == request.resource.contentType;
    }

    function referenceIsReady(atelierId, requestId, referenceId) {
      let referencePath = referenceRecordPath(atelierId, requestId, referenceId);
      return firestore.exists(referencePath)
        && (!('uploadStatus' in firestore.get(referencePath).data)
          || firestore.get(referencePath).data.uploadStatus == 'ready');
    }

    function mayReadOwnPublicReference(atelierId, requestId) {
      let requestPath = /databases/(default)/documents/ateliers/$(atelierId)/quoteRequests/$(requestId);
      return signedIn()
        && request.auth.token.email_verified == true
        && firestore.exists(requestPath)
        && firestore.get(requestPath).data.email == request.auth.token.email;
    }

    function isReferenceImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAtelierFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
    }

    match /ateliers/{atelierId}/branding/{fileName} {
      allow read: if isAtelierMember(atelierId);
      allow create, update: if isAtelierMember(atelierId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAtelierMember(atelierId);
    }

    match /ateliers/{atelierId}/portfolio/{projectId}/{fileName} {
      allow read: if isAtelierMember(atelierId)
        || (firestore.exists(/databases/(default)/documents/publicAteliers/$(atelierId)/portfolio/$(projectId))
          && firestore.get(/databases/(default)/documents/publicAteliers/$(atelierId)/portfolio/$(projectId)).data.public == true
          && firestore.get(/databases/(default)/documents/publicAteliers/$(atelierId)).data.published == true);
      allow create, update: if isAtelierMember(atelierId) && isReferenceImage();
      allow delete: if isAtelierMember(atelierId);
    }

    match /ateliers/{atelierId}/quoteRequests/{requestId}/references/{referenceId} {
      allow read: if referenceIsReady(atelierId, requestId, referenceId)
        && (isAtelierMember(atelierId) || mayReadOwnPublicReference(atelierId, requestId));
      allow create: if isReferenceImage() && mayWritePublicReference(atelierId, requestId, referenceId);
      allow update, delete: if false;
    }

    match /ateliers/{atelierId}/clients/{clientId}/measurements/{fileName} {
      allow read: if isAtelierMember(atelierId);
      allow create, update: if isAtelierMember(atelierId) && isAtelierFile();
      allow delete: if isAtelierMember(atelierId);
    }

    match /ateliers/{atelierId}/orders/{orderId}/production/{photoId} {
      function photoPath() {
        return /databases/(default)/documents/ateliers/$(atelierId)/orders/$(orderId)/photos/$(photoId);
      }
      allow read: if hasAtelierPermission(atelierId, 'orders:read')
        || (ownVerifiedOrder(atelierId, orderId)
          && firestore.exists(photoPath())
          && firestore.get(photoPath()).data.uploadStatus == 'ready'
          && firestore.get(photoPath()).data.visibleToClient == true);
      allow create: if hasAtelierPermission(atelierId, 'orders:manage')
        && firestore.exists(photoPath())
        && firestore.get(photoPath()).data.uploadedBy == request.auth.uid
        && firestore.get(photoPath()).data.uploadStatus == 'pending'
        && request.resource.size <= 10 * 1024 * 1024
        && isReferenceImage();
      allow update, delete: if false;
    }

    match /ateliers/{atelierId}/orders/{orderId}/{area}/{fileName} {
      allow read: if hasAtelierPermission(atelierId, 'orders:read');
      allow create, update: if isAtelierMember(atelierId)
        && area in ['references', 'approvals', 'documents', 'shipping']
        && isAtelierFile();
      allow delete: if isAtelierMember(atelierId)
        && area in ['references', 'approvals', 'documents', 'shipping'];
    }

    match /ateliers/{atelierId}/{area}/{fileName} {
      allow read: if isAtelierMember(atelierId);
      allow create, update: if isAtelierMember(atelierId)
        && area in ['contracts', 'invoices']
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAtelierMember(atelierId) && area in ['contracts', 'invoices'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
