{
  "name": "cosmaker-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --project demo-cosmaker --only firestore,storage \"vitest run tests/rules\"",
    "test:commercial": "npm run functions:build && node scripts/test-commercial-emulator.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:tenants": "node scripts/capture-public-tenant-screenshots.mjs",
    "screenshots:commercial": "node scripts/capture-commercial-screenshots.mjs",
    "docs:diagrams": "node scripts/docs-diagrams.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:local": "npm run functions:build && firebase emulators:start --project demo-cosmaker --only auth,firestore,storage,functions,pubsub",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "commercial:migrate": "node scripts/migrate-commercial-state.mjs",
    "tenant:slug": "node scripts/migrate-public-tenant-slug.mjs",
    "admin:provision": "node scripts/provision-platform-admin.mjs",
    "functions:build": "npm --prefix functions run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
